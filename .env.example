# InvoiceIQ Environment Configuration
ENVIRONMENT=development
DATABASE_PATH=data/invoiceiq.db

# Google Gemini API (Primary Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=15.0

# Ollama Local Qwen2.5-VL 3B (Secondary Fallback Provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_SECONDS=30.0

# Tolerance & Business Rules
DEFAULT_TOLERANCE_PERCENT=0.02

# Cloud Storage Persistence (Experimental)
ENABLE_GCS_BACKUP=false
GCS_BUCKET_NAME=

